# GitLab authentication
GITLAB_TOKEN=

# Selects an entry from config/gitlab_instances_config.json
GITLAB_CONFIG_KEY=ug-onprem-prod
GITLAB_INSTANCE_CONFIG_FILE=config/gitlab_instances_config.json

# Cortex Cloud authentication
CORTEX_API_KEY_ID=
CORTEX_API_SECRET=
CORTEX_API_URL=https://api-yourfqdn

# Execution mode: DRY_RUN or LIVE
RUN_MODE=DRY_RUN

# Synchronization limits
TOP_N_PROJECTS=10
ACTIVITY_THRESHOLD_MINUTES=1440

# Optional GitLab project filtering
# GITLAB visibility is configured per instance in config/gitlab_instances_config.json

# Generated Cortex role settings
CORTEX_ROLE_NAME_PREFIX=devex_
# Replace with a permission returned by Cortex permission configuration.
CORTEX_ROLE_COMPONENT_PERMISSIONS=appsec.repositories.view
